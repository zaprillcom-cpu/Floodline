# Floodline local configuration.
# Copy to .env. No secrets belong in this file or in the repo.
# The first slice stubs the LLM planner, so there is no model API key.

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=floodline

# FalkorDB v4.22.0 defaults TIMEOUT to 1000 ms. The compose file overrides this.
# FALKORDB_ARGS=TIMEOUT 120000 RESULTSET_SIZE 1000000

# Used by the Next.js dev server (and Vercel) to proxy /api to FastAPI.
# On Vercel set this to the Railway origin, with no trailing slash:
#   https://floodline-production.up.railway.app
FLOODLINE_API_ORIGIN=http://127.0.0.1:8000

# Railway only. Guards POST /api/admin/load-valencia. Leave empty locally.
# Never commit a real value.
ADMIN_TOKEN=
API_PORT=8000
WEB_PORT=3000
